<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sound_speed_bridge</name>
  <version>0.0.1</version>
  <description>Serial-to-ROS bridge for real-time sound-speed sensors (AML SVS, Valeport miniSVS, etc.) with optional UDP fan-out for downstream consumers (M3 sonar software, QINSy).</description>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>marine_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>python3-serial</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
